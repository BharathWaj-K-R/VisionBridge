ENV=development
DATABASE_URL=sqlite:///./visionbridge.db
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.onrender.com
LETTER_BASE_MODEL_PATH=./app/models/weights/letter_base_model.pt
ADAPTER_WEIGHTS_DIR=./app/models/weights/adapters
TRANSLATE_RATE_LIMIT_PER_MINUTE=60
CALIBRATION_RATE_LIMIT_PER_MINUTE=5

REGISTER_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_MINUTE=5
VERIFY_OTP_RATE_LIMIT_PER_MINUTE=10
RESEND_OTP_RATE_LIMIT_PER_HOUR=5
OTP_EXPIRY_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=VisionBridge <verify@your-verified-domain.example>
