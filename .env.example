# Local development defaults. Never commit real secrets.
ENV=development
SECRET_KEY=dev-secret-change-me
DATABASE_URL=sqlite:///./visionbridge.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRANSLATE_RATE_LIMIT_PER_MINUTE=60
CALIBRATION_RATE_LIMIT_PER_MINUTE=5
LETTER_BASE_MODEL_PATH=backend/app/models/weights/letter_base_model.pt
ADAPTER_WEIGHTS_DIR=backend/app/models/weights/adapters
